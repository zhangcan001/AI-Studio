{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Studio",
  "version": "0.9.0",
  "identifier": "com.aistudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Studio - 本地 AI 创作工作台",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "本地 AI 创作工作台",
    "longDescription": "面向本地 ComfyUI 的 AI 图片与视频创作工作台。",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
